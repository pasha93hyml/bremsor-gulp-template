{% from './../macro/icon.twig' import svg %}



<header
    data-header
    class="{{ current_page == 'index' ? 'w-full fixed h-14 lg:h-18 flex items-center z-51 transition:background-color duration-500 bg-black-main/65 top-9 lg:top-10 hover:bg-black-main -translate-y-[1px]' : 'w-full fixed h-14 lg:h-18 flex items-center z-51 transition:background-color duration-500 bg-black-main/65 top-0 lg:top-0 hover:bg-black-main' }}"

>

  {% include './../components/header/mobile-menu.twig' %}
  {% include './../components/header/shop-list.twig' with { brands: brands.brandsList } %}

  <div class="container h-full">
    <div
        class="{{ header_variant == 'default' ? 'w-full h-full flex items-center gap-2' : 'w-full h-full flex items-center gap-2 border-b border-white/[.45]' }}">
      <button
          type="button"
          class="lg:hidden text-white"
          data-mobile-toggle
      >
        {{ svg('burger-menu', 'w-5') }}
      </button>
      <div class="lg:hidden flex w-7.5 h-7.5">

      </div>
      <nav class="nav hidden lg:block" data-desktop-only>
        <ul class="flex items-center gap-5 uppercase text-xs font-bold text-white">
          <li class="hover:text-white/40 transition duration-300 ease">
            <a
                href="#"
                data-shop-toggle
                class="uppercase cursor-pointer replace-animate"
                data-replace="shop"
            >
              <span>shop</span>
            </a>
          </li>
          <li class="hover:text-white/40 transition duration-300 ease">
            <a href="/request-order.html" data-replace="custom order" class="replace-animate"><span>custom order</span></a>
          </li>
          <li class="hover:text-white/40 transition duration-300 ease">
            <a href="/installation.html" data-replace="installation" class="replace-animate"><span>installation</span></a>
          </li>
          <li class="hover:text-white/40 transition duration-300 ease">
            <a href="/about.html" data-replace="about" class="replace-animate"><span>about</span></a>
          </li>
        </ul>
      </nav>
      <div class="hidden xl:block w-17 min-w-17">

      </div>
      <a href="/" class="mx-auto">
        <img
            src="/assets/images/{{ isMobile ? 'logo-mobile.png' : 'logo.png' }}"
            alt="bremsor logo"
            width="{{ isMobile ? 113 : 169 }}"
            height="{{ isMobile ? 10 : 15 }}"
            class="w-[90px] aspect-[113/10] lg:w-[120px] lg:aspect-[169/15]"
        />
      </a>
      {% include './../components/shared/search.twig' with {
        placeholder: 'FIND YOUR CALIPER COVERS',
        class: 'hidden lg:flex items-center gap-5'
      } %}

      <div class="flex items-center justify-center gap-2">
        <button type="button"
                class="lg:hidden flex items-center justify-center rounded-full full border border-white w-7.5 h-7.5 text-white">
          {{ svg('search', 'w-3 h-3') }}
        </button>

        <button
            type="button"
            class="text-white w-7.5 h-7.5 flex items-center justify-center rounded-full border border-white group hover:bg-white/10 transition-colors duration-300 cursor-pointer"
        >
          {{ svgInline('cart', 'w-3 h-3') }}
        </button>

      </div>
    </div>
  </div>
</header>



