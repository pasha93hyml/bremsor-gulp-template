{# block variables #}
{% set current_page = getCurrentPage() %}

{% block variables %}
  {% set header_variant = 'default' %}
{% endblock %}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96"/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <link rel="shortcut icon" href="/favicon.ico"/>
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
  <meta name="apple-mobile-web-app-title" content="Bremsor"/>
  <link rel="manifest" href="/site.webmanifest"/>
  <link rel="preload" href="assets/fonts/rivera/RivieraNights-Regular-WebXL.woff2" as="font" type="font/woff2"
        crossorigin>
  <link rel="preload" href="assets/fonts/rivera/RivieraNights-Light-WebXL.woff2" as="font" type="font/woff2"
        crossorigin>
  <link rel="preload" href="assets/fonts/rivera/RivieraNights-Bold-WebXL.woff2" as="font" type="font/woff2" crossorigin>
  <title>{% block title %}Bremsor{% endblock %}</title>
  <link rel="stylesheet" href="/assets/css/main.css">
</head>
<body class="font-riviera bg-black-main overflow-x-hidden min-h-screen">



{# LOADER #}
{% include './../loader/loader.twig' %}


<div class="hidden">{{ getSvgSprite() | raw }}</div>

{% if current_page == 'index' %}
  {% include './../components/homepage/hero/hero-banner-mobile-content.twig' %}
  {% include './../partials/promo.twig' %}
{% endif %}

{% include './../partials/header.twig' with {'current_page': current_page} %}

<main class="{{ current_page == 'index' ? 'pt-9 lg:pt-10' : '' }}">
  {% block content %}{% endblock %}
</main>

{% include './../partials/footer.twig' %}

<script src="/assets/js/main.bundle.js"></script>
</body>
</html>