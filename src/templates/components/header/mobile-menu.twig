{% from './../../macro/icon.twig' import svg %}

<div
    data-mobile-menu
    class="flex flex-col items-end fixed w-screen h-[100dvh] bg-black-second/95 top-0 left-0 pt-20 px-4 z-51 -translate-x-full transition-transform duration-300 ease-in-out"
>
  <button class="w-fit absolute top-8 right-8 text-gray-main" data-mobile-close>
    {{ svgIcon('close', 'w-4 h-4') }}
  </button>
  <ul class="flex flex-col w-full h-full">
    <li>
      <button
          class="flex w-full text-white text-small font-bold py-[26px] px-[30px] border-t border-white/50"
          data-mobile-shop
      >
        SHOP
      </button>
    </li>
    <li>
      <a
          class="flex w-full text-white text-small font-bold py-[26px] px-[30px] border-t border-white/50"
          href="/request-order.html"
      >
        CUSTOM ORDER
      </a>
    </li>
    <li>
      <a
          class="flex w-full text-white text-small font-bold py-[26px] px-[30px] border-t border-white/50"
          href="/"
      >
        INSTALLATION
      </a>
    </li>
    <li>
      <a
          class="flex w-full text-white text-small font-bold py-[26px] px-[30px] border-t border-white/50"
          href="/"
      >
        ABOUT
      </a>
    </li>
    {% include './../shared/search.twig' with {
      placeholder: 'FIND YOUR CALIPER COVERS',
      class: 'flex items-center gap-5 mt-auto w-full'
    } %}
    <li class="flex items-center justify-center gap-5 py-[25px]">
      <a
          href="#"
          class="flex items-center justify-center rounded-full bg-white w-[30px] h-[30px]"
      >
        {{ svg('instagram', 'w-7.5 h-7.5') }}
      </a>
      <a
          href="#"
          class="flex items-center justify-center rounded-full bg-white w-[30px] h-[30px]"
      >
        {{ svg('youtube', 'w-7.5 h-7.5') }}
      </a>
      <a
          href="#"
          class="flex items-center justify-center rounded-full bg-white w-[30px] h-[30px]"
      >
        {{ svg('tik-tok', 'w-7.5 h-7.5') }}
      </a>
    </li>
  </ul>
</div>

