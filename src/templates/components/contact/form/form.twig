{% from 'macro/icon.twig' import svg %}

<form class="flex flex-col gap-6 py-6 px-7.5 rounded-[20px] w-full bg-white" method="post" enctype="multipart/form-data">
  <p class="text-2xl text-black-main font-bold w-full text-center">Get in Touch</p>
  {% include 'components/contact/form/form-group.twig' with (
    {
      fields: [
        {type: 'text', name: 'first-name', label: 'First name*', placeholder: 'Your name here', required: 'true', input_field_classes: ''},
        {type: 'text', name: 'last-name', label: 'Last name*', placeholder: 'Your last name', required: 'true', input_field_classes: ''},
        {type: 'email', name: 'email', label: 'Email address*', placeholder: 'Your e-mail address', required: 'true', input_field_classes: ''},
        {type: 'tel', name: 'phone', label: 'Phone number*', placeholder: 'Your phone number', required: 'true', input_field_classes: ''},
        {type: 'text', name: 'inquiry-subject', label: 'Inquiry subject*', placeholder: 'Inquiry subject here', required: 'true', input_field_classes: ''},
        {type: 'text', name: 'order-number', label: 'Order number*', placeholder: 'Your order number', required: 'true', input_field_classes: '', additional_text: '(optional, unless it\'s a warranty or order-related issue)'},
        {type: 'textarea', name: 'describe-logo', label: 'Describe your inquiry in detail*', placeholder: 'Description here', required: 'true', form_field_classes: ''},
        {type: 'image-upload', name: 'image-upload', label: 'Upload photos of your front and rear calipers (optional)', placeholder: 'Choose file', additional_text: 'Optional – For warranty claims, please include proof of purchase, vehicle details, and a short description of the issue.'}
    ],
      classes: "flex flex-col",
      fields_classes: "flex flex-col w-full lg:grid lg:grid-cols-2 grid-rows-2 gap-4",
      title_classes: "form-group-title text-xl lg:text-2xl leading-[136%] font-bold"
    }
    ) %}

  <div class="flex items-center justify-end">
    <button type="submit" aria-label="submit contact us form" class="text-black-main text-xs leading-1 max-w-40 w-full uppercase font-light flex items-center justify-between border border-black-main rounded-[57px] px-4 py-2 cursor-pointer hover:bg-black-main hover:text-white transition duration-400 ease group">
      submit form
      {{ svg('chevron-left', 'w-3 h-3 rotate-180 group-hover:translate-x-1/2 transition duration-400 ease') }}
    </button>
  </div>
</form>