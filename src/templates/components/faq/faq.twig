<section class="w-full py-25 lg:py-40">
  <div class="max-w-303 px-5 flex flex-col gap-5 mx-auto">
    <h1 class="text-white text-4xl font-light mb-10">Bremsor Caliper Covers – FAQ</h1>
    <div class="flex flex-col w-full gap-7.5">
      {% for section in faq.data %}
        <div class="flex flex-col gap-3 mb-10">
          <h2 class="text-lg font-bold text-white mb-3">{{ section.title }}</h2>
          <div class="space-y-5">
            {% for accordion in section.accordions %}
              {% include './faq-item.twig' with {
                title: accordion.title,
                description: accordion.description,
                button: accordion.button|default(null),
                id: 'accordion-' ~ loop.parent.loop.index ~ '-' ~ loop.index
              } %}
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>