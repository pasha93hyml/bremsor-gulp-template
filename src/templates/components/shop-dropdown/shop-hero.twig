<section class="min-h-[calc(var(--vh,_1vh)_*_100)] flex flex-col bg-white pt-18 lg:pt-30 pb-6">
  <div class="max-w-303 px-5 w-full mx-auto flex-1 flex flex-col">
    <h1 class="text-4xl text-black-main font-light mb-4">Select Your Make</h1>
    <p class="text-xl font-bold mb-12">Choose your make from the list below:</p>

    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-x-5 gap-y-8 my-auto pb-10">
      {% for brand in brands.brandsList %}
        <div class="flex flex-col gap-4">
          <p class="text-2xl font-light text-green-main uppercase">{{ brand.title }}</p>
          <ul class="flex flex-col gap-1">
            {% for item in brand.list %}
              <li class="group flex items-center transition duration-400 ease">
                <span
                    class="flex h-[1px] w-0 overflow-hidden bg-black-main transition-[width] duration-400 ease group-hover:w-2"></span>
                <a href="#" class="text-sm text-black-main group-hover:ml-2 transition-[margin] ease duration-400">{{ item }}</a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endfor %}
    </div>
    <div class="flex flex-col gap-2 mt-auto lg:max-w-190 w-full">
      <p class="text-sm text-black-main text-balance">Bremsor Caliper Covers are custom-made for your specific make, model, year, and brake details. To ensure proper fitment, please select your exact vehicle.</p>
      <p class="text-sm text-black-main">If your vehicle isn’t listed, you can submit a custom request
        <a href="#" class="uppercase underline">HERE</a>.
      </p>
    </div>
  </div>
</section>