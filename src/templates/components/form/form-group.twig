<div class="{{ classes }}"
  {% if data_name %}data-name="{{ data_name }}"{% endif %}
>
  {% if title %}
    <h3 class="{{ title_classes }}">{{ title }}</h3>
  {% endif %}

  {% if subtitle %}
    <p class="{{ subtitle_classes }}">{{ subtitle }}</p>
  {% endif %}

  <div class="{{ fields_classes }}">
    {% for field in fields %}
      {% if field.type == 'text' or field.type == 'email' or field.type == 'tel' %}
        {% include 'components/form/input-field.twig' with field %}
      {% elseif field.type == 'select' %}
        {% include 'components/form/select-field.twig' with field %}
      {% elseif field.type == 'textarea' %}
        {% include 'components/form/textarea-field.twig' with field %}
      {% elseif field.type == 'image-upload' %}
        {% include 'components/form/image-upload-field.twig' with field %}
      {% elseif field.type == 'file-upload' %}
        {% include 'components/form/file-upload-field.twig' with field %}
      {% elseif field.type == 'color-selector' %}
        {% include 'components/form/color-selector-field.twig' with field %}
      {% endif %}
    {% endfor %}
  </div>
  {% if info_title %}
    {% include 'components/form/info-field.twig' with {info_title: info_title} %}
  {% endif %}

  {% if form_footer %}
    {% include 'components/form/form-footer.twig' %}
  {% endif %}
</div>