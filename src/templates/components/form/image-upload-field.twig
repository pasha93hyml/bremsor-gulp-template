{% from 'macro/icon.twig' import svg, icon %}

<div class='{{ "relative form-field js-image-upload-field flex max-lg:mt-11 " ~ field_classes }}'>
  <div class="w-full aspect-[1/1] bg-white/[.12] flex rounded-[10px]" data-field-name="{{ name }}">
    <div class="dashed-border w-full aspect-1/1 flex flex-col" data-target="{{ name }}" data-required="{{ required is defined and required ? 'true' : 'false' }}">
      <div class="flex-1 flex flex-col items-center justify-center w-full aspect-1/1 gap-5 js-upload-placeholder">
        <div class="w-13 h-13 rounded-full border border-white flex items-center justify-center text-[#d9d9d9]">
          <span class="text-xl">{{ svg('union', 'w-2.5 h-2.5') }}</span>
        </div>
        <div class="text-sm leading-[140%] max-w-[144px] mx-auto text-center">{{ text }}</div>
      </div>
      <div class="js-image-preview rounded-[10px] overflow-hidden flex-1 scale-[1.01]" style="display: none;">
        <img src="" alt="{{ label }} preview" class="js-preview-image w-full aspect-1/1 object-cover">
      </div>
    </div>

    <input type="file" id="{{ name }}" name="{{ name }}" class="js-image-upload-input"
           accept="image/*" style="display: none;">
  </div>
  <button type="button"
          class="js-remove-image-btn flex items-center justify-center w-6 h-6 rounded-full bg-white/[.5] absolute top-0 right-0 z-2 -translate-y-1/2 translate-x-1/2 opacity-0">{{ icon('close', 'w-4 h-4') }}</button>
</div>