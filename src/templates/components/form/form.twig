<form class="brake-form js-form" method="post" enctype="multipart/form-data">
  {% include 'components/form/form-group.twig' with (
    {
      title: 'Contact Information:',
      fields: [
      {type: 'text', name: 'first-name', label: 'First name*', placeholder: 'Your name here', required: 'true', input_field_classes: 'max-lg:order-1'},
      {type: 'email', name: 'email', label: 'Email address*', placeholder: 'Enter here', required: 'true', input_field_classes: 'max-lg:order-3'},
      {type: 'text', name: 'last-name', label: 'last name*', placeholder: 'Your name here', required: 'true', input_field_classes: 'max-lg:order-2'},
      {type: 'tel', name: 'phone', label: 'Phone number*', placeholder: 'Enter here', required: 'true', input_field_classes: 'max-lg:order-4'},
    ],
      classes: "form-group flex flex-col ld:gap-14 gap-5 text-white mb-19 lg:mb-25",
      fields_classes: "form-fields flex flex-col w-full lg:grid lg:grid-cols-2 grid-rows-2 gap-7.5",
      title_classes: "form-group-title text-xl lg:text-2xl leading-[136%] font-bold"
    }
    ) %}

  {% include 'components/form/form-group.twig' with {
    title: 'Vehicle Information:',
    subtitle: 'All fields are required',
    fields: [
      {type: 'select', name: 'make', label: 'Make', options: dropdowns.make, field_classes: 'select-field-wrap max-lg:col-span-full', required: 'true'},
      {type: 'select', name: 'model', label: 'Model', options: dropdowns.model, field_classes: 'select-field-wrap max-lg:col-span-full', required: 'true'},
      {type: 'select', name: 'year', label: 'Year', options: dropdowns.year, field_classes: 'lg:col-start-1 max-lg:col-span-full select-field-wrap', required: 'true'},
      {type: 'select', name: 'info', label: 'Additional Info', options: dropdowns.info, field_classes: 'lg:col-start-2 select-field-wrap max-lg:col-span-full', required: 'true'},
      {type: 'image-upload', name: 'front_brake', label: 'Front Brake Image', text: 'Upload Front Brake Image', field_classes: 'lg:col-start-3 lg:row-span-full', required: 'true'},
      {type: 'image-upload', name: 'rear_brake', label: 'Rear Brake Image', text: 'Upload Rear Brake Image', field_classes: 'lg:col-start-4 lg:row-span-full', required: 'true'},
      {type: 'upload-info', text: 'Ensure clear images of both front and rear brakes, like on example:', field_classes: 'lg:col-start-1 lg:col-end-3 lg:row-start-3 lg:row-end-5'}
    ],
    classes: "form-group text-white flex flex-col gap-5 relative",
    title_classes: "form-group-title text-xl lg:text-2xl leading-[136%] font-bold",
    subtitle_classes: 'text-base leading-[26px] mb-6.5',
    fields_classes: 'grid grid-cols-2 lg:grid-cols-4 grid-rows-4 gap-7.5 lg:max-h-[270px]'
  } %}

  {% include 'components/form/form-group.twig' with {
    title: 'Design Preferences:',
    fields: [
      {type: 'color-selector', name: 'color', label: 'Select Color'}
    ],
    classes: 'w-full flex flex-col text-white gap-10 lg:gap-16 mt-20 lg:mt-25 mb-16',
    title_classes: 'text-xl lg:text-2xl leading-[136%] font-bold',
    data_name: 'color_pick'
  } %}

  {% include 'components/form/form-group.twig' with {
    title: 'Describe your logo*',
    fields: [
      {
        type: 'textarea',
        name: 'logo_description',
        label: 'Logo Description',
        textarea_classes: 'min-h-[270px] w-full border border-white p-4 rounded-[10px] text-sm font-normal leading-[180%] outline-none',
        form_field_classes: 'grow-1 flex',
        placeholder: 'Font, style, etc.',
        required: 'true'
      },
      {
        type: 'file-upload',
        name: 'logo_file',
        label: 'Upload Logo',
        accept: '.svg,.png,.jpg,.jpeg,.pdf,.ai',
        field_classes: 'sm:w-[270px] sm:aspect-1/1 w-full h-fit',
        text: 'Upload a Sketch or Vector File. PNG, JPG, PDF, AI, SVG (Optional)',
        required: 'true'
      }
    ],
    classes: 'flex flex-col gap-5 text-white mb-18 lg:mb-28.5',
    title_classes: 'text-sm leading-[18px] uppercase text-white',
    fields_classes: 'w-full flex gap-7.5 flex-wrap',
    data_name: 'custom_logo'
  } %}

  {% include 'components/form/form-group.twig' with {
    title: 'Additional Design Requests',
    fields: [
      {
        type: 'textarea',
        name: 'additional_requests',
        label: 'Additional Design Requests',
        textarea_classes: 'min-h-[270px] w-full border border-white p-4 rounded-[10px] text-sm font-normal leading-[180%] outline-none',
        placeholder: "Any other details you'd like to include?"
      }
    ],
    classes: 'flex flex-col gap-5 text-white mb-36 lg:mb-43',
    title_classes: 'text-sm leading-[18px] uppercase text-white',
    form_footer: true,
    data_name: 'design_request'
  } %}

</form>