{% from './../../macro/icon.twig' import svg %}

<section class="min-h-[calc(var(--vh,_1vh)_*_100)] flex flex-col bg-white pt-18 lg:pt-30 pb-6 text-black-main">
  <div class="max-w-303 px-5 w-full mx-auto max-sm:mt-5 flex-1 flex flex-col">
    <h1 class="text-4xl font-light text-black-main w-full text-center mb-10">Custom Brake Caliper Covers for <span class="js-make-selected-model" data-model="acura">Acura</span></h1>
    <div class="flex flex-col gap-5 w-full">
      <div class="flex max-md:flex-col items-center max-md:justify-center md:gap-10 gap-5">
        <p class="text-lg font-bold">
          Select the desired model from the list:
        </p>
        <div class="flex items-center gap-3 max-sm:justify-between max-sm:w-full">
          <div class="relative js-simple-dropdown max-sm:w-full">
            <button type="button"
                    class="flex items-center justify-between w-full sm:w-80 h-9 text-xs font-bold text-black-main py-2 px-3 border border-black-main rounded-[100px] js-dropdown-trigger"
                    aria-label="reviews filter button"
                    data-default-value="most recent">
              <span class="js-dropdown-value">Select model</span>
              {{ svg('chevron-down', 'w-3 h-3 transition duration-400 ease dropdown-icon') }}
            </button>
            <div
                class="absolute w-full left-0 top-[calc(100%_+_10px)] rounded-[10px] bg-white shadow-xl/20 grid-row-animation-container no-padding js-dropdown-content"
            >
              <div class="flex flex-col max-h-87 overflow-y-scroll inner-dropdown-wrap">
                <div class="relative flex items-center py-2 px-3 mb-4 border border-black-main rounded-[100px]">
                  <input type="text" name="search_model" placeholder="FIND YOUR CALIPER COVERS"
                         class="w-full text-xs text-black-main font-light pr-3.5 placeholder:text-xs placeholder:font-light placeholder:text-black-main outline-none js-searchlist-input" data-target="models_list">
                  {{ svg('search', 'w-3 h-3 min-w-3 absolute right-3') }}
                </div>
                <ul class="w-full min-h-0 flex flex-col gap-1 js-searchlist-list" data-name="models_list">
                  {% for i in 1..20 %}
                    <li>
                      <button type="button"
                              aria-label="pick model cls 400"
                              class="flex items-center gap-1 text-xs leading-1.1 text-black-main w-full hover:bg-black-main/30 cursor-pointer text-left px-2 py-1 rounded js-dropdown-option dropdown-option-with-circle"
                              data-seearch-value="CLS400"
                              data-value="CLS400-{{ i }}"
                      >
                        <span class="flex items-center justify-center w-3 h-3 rounded-full bg-black-main/30 border border-black-main">
                          <span class="w-1.5 h-1.5 rounded-full bg-black-main opacity-0 dropdown-option-circle">
                          </span>
                        </span>
                        CLS400
                      </button>
                    </li>

                  {% endfor %}

                </ul>

              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="flex-1 flex gap-x-7.5 gap-y-12 flex-wrap"></div>

    <div class="w-full flex items-start justify-between max-md:flex-col max-md:gap-5">
      <p class="text-xs leading-[120%] font-light text-black-main lg:max-w-91">
        Add Some Style To Your Ride — Our caliper covers are designed to be an attractive addition to your brakes. These covers fit directly over your brake calipers, giving them a sleek and upscale look while also protecting them from dust and debris. 
      </p>
      {% include 'components/shared/ui/pagination.twig' with {
        totalPages: 15,
        color: 'black-main',
        visiblePages: 6,
        margin_top: 0,
      } %}
    </div>
  </div>
</section>

