{% from 'macro/icon.twig' import svg %}

<div data-aos="fade-up" class="relative flex flex-col gap-[40px]">
  <div
      class="absolute inset-0 bg-gradient-to-b from-transparent to-black-second mix-blend-multiply opacity-80 lg:hidden"></div>

  <div class="w-[470px] aspect-1/1 overflow-hidden">
    {% set imageOptions = {
      class: 'w-[470px] aspect-1/1 hover:scale-[1.3] transition-scale duration-400 ease',
      width: '470',
      height: '470',
      loading: 'lazy'
    } %}
    {{ picture(item.image_src, item.title, imageOptions) | raw }}
  </div>

  <div class="absolute max-lg:bottom-2.5 max-lg:left-2.5 lg:relative lg:flex items-end gap-7.5 text-white">
    <p class="font-bold text-[16px] md:text-xl leading-none">{{ item.title }}</p>
    <a href="#"
       class="hidden lg:flex items-center justify-center w-8.5 h-8.5 rounded-full border border-white hover:bg-white/20 transition-all duration-300 ease cursor-pointer">
      {{ svg('chevron-left', 'rotate-180 -translate-x-[2px] w-3 h-3') }}
    </a>
  </div>
</div>