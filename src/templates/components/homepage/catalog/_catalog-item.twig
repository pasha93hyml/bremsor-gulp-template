{% from 'macro/icon.twig' import svg %}

<a href="#" data-aos="fade-up" class="relative flex flex-col gap-[40px] group cursor-pointer">
  <span
      class="absolute block inset-0 bg-gradient-to-b from-transparent to-black-main mix-blend-multiply opacity-80 lg:hidden"></span>

  <span class="max-w-[470px] block w-fit aspect-1/1 overflow-hidden">
    {% set imageOptions = {
      class: 'w-[470px] aspect-1/1 hover:scale-[1.3] transition-scale duration-400 ease',
      width: '470',
      height: '470',
      loading: 'lazy'
    } %}
    {{ picture(item.image_src, item.title, imageOptions) | raw }}
  </span>

  <span class="block absolute max-lg:bottom-2.5 max-lg:left-2.5 lg:relative lg:flex items-end gap-7.5 text-white">
    <span class="block font-bold text-[16px] md:text-xl leading-none">{{ item.title }}</span>
    <button
       class="hidden lg:flex items-center justify-center w-8.5 h-8.5 rounded-full border border-white group-hover:bg-white/30 transition-all duration-300 ease cursor-pointer">
      {{ svg('chevron-left', 'rotate-180 -translate-x-[2px] w-3 h-3') }}
    </button>
  </span>
</a>