{% from 'macro/icon.twig' import svg %}

<div data-aos="fade-up" class="relative flex flex-col gap-[40px]">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent to-black-second mix-blend-multiply opacity-80 lg:hidden"></div>

  {% set imageOptions = {
    class: 'w-[470px] aspect-1/1',
    width: '470',
    height: '470',
    loading: 'lazy'
  } %}
  {{ picture(item.image_src, item.title, imageOptions) | raw }}

  <div class="absolute max-lg:bottom-2.5 max-lg:left-2.5 lg:relative lg:flex items-end gap-7.5 text-white">
    <p class="font-bold text-[16px] md:text-[32px] leading-none">{{ item.title }}</p>
    <a href="#" class="hidden lg:flex items-center justify-center w-[45px] h-[45px] rounded-full border border-white hover:bg-white/20 transition-all duration-300 ease cursor-pointer">
      {{ svg('chevron-left', 'rotate-180 -translate-x-[2px]') }}
    </a>
  </div>
</div>