<section class="py-15 lg:py-25 relative">
  <div class="container px-[225px] max-lg:px-4">
    <h2
        data-aos="fade-up"
        class="text-2xl leading-[119%] lg:text-[36px]/[119%] text-white max-lg:text-balance text-center font-light"
    >
      We Produce Caliper Covers <br class="hidden lg:block" />
      for All Makes <br class="lg:hidden" />& Models
    </h2>

    <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-x-6.5 lg:gap-y-15 mt-12 lg:mt-20 max-w-367.5 mx-auto">
      {% if catalog.catalog_items %}
        {% for item in catalog.catalog_items %}
          {% include './_catalog-item.twig' with { item: item } only %}
        {% endfor %}
      {% else %}
        <p class="text-white col-span-full text-center">No catalog items found.</p>
      {% endif %}
    </div>

    <div class="flex items-center flex-wrap lg:flex-nowrap lg:justify-center gap-4 justify-center lg:mt-27.5 mt-[70px]">
      <a
          href="#"
{#          data-aos="fade-down"#}
          class="w-fit flex items-center justify-center bg-black-main border border-white rounded-[57px] text-white text-small lg:text-sm leading-none py-[14px] px-[30px] lg:px-12 lg:mx-auto uppercase cursor-pointer hover:bg-white hover:text-black-main transition duration-300 ease"
      >
        shop all makes
      </a>
    </div>
  </div>
</section>