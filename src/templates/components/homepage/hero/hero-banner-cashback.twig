      <a
          href="#"
          class="flex items-center justify-center rounded-[57px] border border-white py-[14px] px-[18px] text-sm text-black-second bg-white leading-[18px] uppercase w-[200px] cursor-pointer hover:bg-green-main hover:text-white hover:border-green-main transition-all duration-300 ease"
      >
        custom gallery
      </a>
    </div>
  </div>
  <button
      type="button"
      class="absolute top-1/2 -translate-y-1/2 -translate-x-full w-full max-w-[58px] writing-vertical text-black-second bg-white rounded-l-[20px] flex flex-row-reverse text-nowrap items-center justify-center gap-5 py-4 px-8 font-bold text-[18px] leading-[180%] uppercase cursor-pointer hover:bg-white/80 transition-all duration-300 ease"
      data-cashback-toggle
  >
    <p>Earn $50 back</p>
    {{ svg('chevron-left', 'w-3 h-3 rotate-0' ) }}
