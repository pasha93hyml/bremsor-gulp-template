    data-cashback-banner
>
  {{ picture('/assets/images/banner-cashback.png', 'cashback', {
    width: '915',
    height: '472',
    class: 'absolute inset-0'
  }) }}
  <div
      class="absolute w-fit max-w-[570px] left-0 top-0 bottom-0 bg-black-second/82 flex flex-col justify-center gap-6 py-[73px] px-[44px] rounded-l-[20px]">
    <h4 class="font-bold text-white text-balance leading-[127%] text-[20px] uppercase">
      Get $50 Back for Your Content!
    </h4>
    <p class="text-white text-[18px] leading-[127%] mb-4 capitalize">
      Submit High-Quality Photos and Videos of Your Caliper Covers. Get
      Rewarded for Your Style – $50 Back for Approved Content Submissions
    </p>
    <div class="flex items-center gap-[18px]">
      <a
