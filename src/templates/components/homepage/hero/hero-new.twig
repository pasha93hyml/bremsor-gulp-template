<section class="flex relative w-screen overflow-x-hidden md:aspect-[2684/1643] @container hero-section">
  <div class=" absolute inset-[0px_-100dvw_0px] md:inset-0 pointer-events-none touch-none z-1">
    {{ picture('/assets/images/hero-bg.png', 'background for first screen', {
      width: '1920',
      height: '1128',
      class: 'absolute z-2 top-0 left-44 md:left-0 object-cover md:w-full h-[calc(var(--vh,_1vh)_*_100_-_var(--promo-height))] touch-none'
    }) }}

    <div class="hidden absolute z-3 inset-0 bg-black-main/10"></div>
  </div>
  <div
      class=" absolute z-3 right-[8dvw] md:right-[4dvw] lg:bottom-[23vh] max-md:-translate-y-[80%] md:bottom-[20dvh] w-[60dvw] md:w-[50dvw] max-md:top-75 lg:w-[40dvw] aspect-[1122/732] pointer-events-none">
    {{ picture('/assets/images/hero-calipers.png', 'calipers', {
      width: '1122',
      height: '732',
      class: 'absolute  md:inset-0 object-cover w-full aspect-[1122/732]'
    }) }}
  </div>

