{% from 'macro/icon.twig' import svg %}

{% set page_id = getCurrentPage() %}

<section
    class="bg-black-main py-[40px] lg:pt-9 lg:pb-10">
  <div class="container">
    <div class="flex items-center justify-center flex-col relative">
      <h2
          data-aos="fade-up"
          class="text-white font-light text-2xl lg:text-[36px] leading-none mb-2 relative z-10"
      >
        {{ title }}
      </h2>
      <div class="flex items-center justify-center w-full absolute top-[5%] pt-[calc(var(--vh,_1vh)_*_8)] z-10">
        <div class="js-3d-rotation-indicator">

        </div>
      </div>
{#
      {% include "components/3d-viewer/model-viewer.twig" with {
        model: "/assets/3d/front_only.glb",
        js_class: 'js-model-viewer model-viewer'
      } %}
#}

    </div>

    <div
        class="max-w-[1170px] bg-[#d9d9d9] rounded-[30px] lg:rounded-[100px] py-5 px-7 lg:gap-0 gap-7 text-black-main flex flex-wrap items-center justify-between mx-auto mt-0 lg:mt-12"
    >
      <p class="text-sm max-lg:text-balance lg:text-base lg:text-left text-center w-full lg:w-auto lg:flex-1 lg:pr-8">
        Order a unique style with color and logo of your choice
      </p>
      <button
          type="button"
          class="flex items-center justify-between rounded-[57px] max-h-[45px] border border-black-main py-2.5 px-[18px] text-small lg:text-sm leading-none uppercase w-full lg:w-auto lg:min-w-[200px] cursor-pointer hover:bg-black-main hover:text-white transition-all duration-300 ease group"
      >
        <span class="flex-grow text-center lg:text-left">INQUIRE</span>
        {{ svg('chevron-left', 'w-3 h-3 fill-[#0A0A0A] group-hover:fill-white transition-colors duration-300 ease rotate-180') }}
      </button>
    </div>
  </div>
</section>
