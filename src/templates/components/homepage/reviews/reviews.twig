{% from 'macro/icon.twig' import svg %}

<section class="lg:py-25">
  <div class="max-w-[1202px] mx-auto relative px-4">
    <h2
        data-aos="fade-up"
        class="font-light text-2xl lg:text-[36px] text-white max-w-50 max-md:mx-auto md:max-w-[550px] leading-[1.1] mb-10 md:mb-25 text-balance"
    >
      Reviews from our valued customers
    </h2>

    <div data-aos="fade-up">
      <div id="reviews-slider" class="keen-slider pb-10">
        {% if reviews and reviews.reviewData %}
          {% for review in reviews.reviewData %}
            <div class="keen-slider__slide bg-black border border-white text-white p-[15px]">
              <div class="flex justify-between mb-[30px] gap-4">
                <p class="text-[20px] font-light text-white flex-shrink">
                  {{ review.title }}
                </p>
                {% set reviewImageOptions = {
                  class: 'w-[100px] h-[100px] lg:w-[135px] lg:h-[135px] object-cover flex-shrink-0',
                  width: '135',
                  height: '135',
                  loading: 'lazy'
                } %}
                {{ picture(review.image_src, review.title, reviewImageOptions) | raw }}
              </div>
              <h3 class="font-bold text-[18px] leading-none mb-[24px]">
                {{ review.name }}
              </h3>
              <p class="text-sm text-white mb-[3px] text-balance">
                {{ review.description }}
              </p>
            </div>
          {% endfor %}
        {% else %}
          <p class="text-white text-center py-10">No reviews found.</p>
        {% endif %}
      </div>



      {% if reviews and reviews.reviewData and reviews.reviewData | length > 1 %}
        <div id="reviews-slider-dots" class="md:hidden flex items-center justify-center gap-2 mt-[10px]">
        </div>
      {% endif %}

    </div>
    <div
        class="max-md:mt-8 max-md:mx-auto relative md:absolute md:top-10 md:right-4 md:flex gap-7.5 max-w-40 w-full"
    >
      <a href="#" class="flex items-center justify-center text-white text-xs uppercase text-white font-bold w-full max-md:mx-auto py-2 px-4 rounded-[57px] border border-white hover:bg-white hover:text-black-main transition duration-400 ease">read more</a>
{#      <button#}
{#          aria-label="Previous Review"#}
{#          id="reviews-slider-prev"#}
{#          class="h-12 w-12 rounded-full bg-white/[.08] hover:bg-white/[.25] flex items-center justify-center transition cursor-pointer group"#}
{#      >#}
{#        {{ svg('chevron-left', 'text-white w-3.5 h-3.5 transition-transform translate-x-[2px] group-hover:scale-110') }}#}
{#      </button>#}
{#      <button#}
{#          aria-label="Next Review"#}
{#          id="reviews-slider-next"#}
{#          class="h-12 w-12 rounded-full bg-white/[.1] hover:bg-white/[.2] flex items-center justify-center transition cursor-pointer group"#}
{#      >#}
{#        {{ svg('chevron-left', 'text-white w-3.5 h-3.5 transition-transform -translate-x-[2px] group-hover:scale-110 rotate-180') }}#}
{#      </button>#}
    </div>
  </div>
</section>