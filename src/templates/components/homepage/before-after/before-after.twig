{% from 'macro/icon.twig' import svg %}

<section class="bg-black-second lg:pt-[100px]">
  <div class="container">
    <h2
        data-aos="fade-up"
        class="text-white text-2xl lg:text-[36px] font-light leading-[136%] text-center mb-[50px] lg:mb-[75px]"
    >
      Before & After
    </h2>
  </div>

  <div data-aos="fade" class="w-full select-none">
    <img-comparison-slider
        class="relative w-full aspect-[1920/1080] cursor-ew-resize outline-none"
        value="50"
    >
      <img
          slot="first"
          src="/assets/images/before_retouch.png"
          alt="Before"
          width="1920"
          height="1080"
          loading="lazy"
          class="w-full h-auto block"
      />

      <img
          slot="second"
          src="/assets/images/after_retouch.png"
          alt="After"
          width="1920"
          height="1080"
          loading="lazy"
          class="w-full h-auto block"
      />
      <div slot="handle" class="h-10 w-10 lg:h-[66px] lg:w-[66px] -ml-5 -mt-5 lg:-ml-[33px] lg:-mt-[33px] px-1 lg:py-[15px] lg:px-[10px] rounded-full bg-white absolute top-1/2 flex items-center justify-between cursor-pointer">
        <span class="text-xs hidden">BEFORE</span>
        <span class="flex items-center justify-center">{{ svg('chevron-left', 'translate-y-[1px] max-lg:w-3') }}</span>
        <span class="w-[1px] bg-black-second absolute top-[5px] bottom-[5px] inset-x-1/2"></span>
        <span class="text-xs hidden">AFTER</span>
        <span class="flex items-center justify-center">{{ svg('chevron-left', 'rotate-180 max-lg:w-3') }}</span>
      </div>

    </img-comparison-slider>
  </div>
</section>