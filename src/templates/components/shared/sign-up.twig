{% from 'macro/icon.twig' import svg %}

<div class="{{ className | default('') }}">
  <h5 class="uppercase">sign up for newsletter</h5>
  <p class="font-light mb-6 md:mb-[40px]">
    Promotions, new products and sales. <br />
    Directly to your inbox
  </p>

  <div class="lg:w-[370px] max-w-[370px] relative flex items-center justify-center border border-white rounded-[57px] px-[18px] py-[14px]">
    <input
        type="email"
        name="email"
        class="w-full border-none outline-0 placeholder:text-white text-white text-[14px]/[18px] bg-transparent"
        placeholder="YOUR EMAIL"
    />
    <button type="submit" class='absolute right-6 cursor-pointer'>
      {{ svg('chevron-left', 'rotate-180') }}
    </button>
  </div>
</div>