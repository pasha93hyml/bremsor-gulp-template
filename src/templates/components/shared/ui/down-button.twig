<button type="button" aria-label="scroll down one section"
        class="absolute z-5 left-1/2 -translate-x-1/2 bottom-{{ bottom | default('30') }} mt-{{ margin_top | default('0') }} w-12 h-12 min-w-12 rounded-full border border-white flex items-center justify-center text-white cursor-pointer group js-scroll-down-btn" data-target="{{ target | default('') }}">
  {{ svg('chevron-down', 'w-3 h-3 min-w-3 transition duration-400 ease group-hover:translate-y-1/2') }}
</button>