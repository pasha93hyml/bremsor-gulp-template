{% from './../../macro/icon.twig' import svg %}

<div class="{{ class|default('') }}">
  <div class="text-white text-xs relative border border-white rounded-[100px] py-2.5 px-5 w-full lg:w-[350px] flex items-center lg:mr-3">
      <input
          type="text"
          class="text-white lg:h-4 placeholder:text-white placeholder:text-[12px] outline-0 text-xs leading-none w-full pr-[45px]"
          placeholder="{{ placeholder|default('Search') }}"
      />
    {{ svg('search', 'absolute right-4 top-[50%] translate-y-[-50%] w-4 h-4') }}
  </div>
</div>