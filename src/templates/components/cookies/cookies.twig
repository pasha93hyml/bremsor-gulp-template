<section class="w-full py-25 lg:py-40">
  <div class="max-w-303 w-full px-5 mx-auto flex flex-col gap-20">
    <div class="flex flex-col gap-5 mb-5">
      <h1 class="text-4xl font-light capitalize text-white">Cookies Policy</h1>
      <p class="text-sm max-w-120 w-full text-white">This Cookies Policy explains how Bremsor ("we," "us," or "our") uses cookies and similar technologies when you visit or interact with our website.</p>
    </div>
    <div class="flex flex-col gap-5">
      <h2 class="text-2xl text-white font-light capitalize">What Are Cookies?</h2>
      <p class="text-sm text-white">Cookies are small data files that are placed on your device when you visit a website. They help websites operate more efficiently and provide valuable information to website owners.</p>
    </div>
    <div class="flex flex-col gap-5">
      <h2 class="text-2xl text-white font-light capitalize">How We Use Cookies</h2>
      <p class="text-sm text-white">We use cookies to enhance your browsing experience, provide important site functionality, and help us understand how our website is being used. <br/>The cookies we use fall into the following categories:</p>

      <div class="grid grid-cols-1 xs:grid-cols-2 lg:grid-cols-4 w-full gap-10 mt-10">
        {% set listData = [
          {
            title: 'Essential Cookies:',
            description: 'Required for the operation of our website, such as remembering cart items and secure account logins.',
          },
          {
            title: 'Performance and Analytics Cookies:',
            description: 'Used to collect anonymous data on how visitors use our site, allowing us to improve functionality and user experience (e.g., Google Analytics).',
          },
          {
            title: 'Marketing Cookies:',
            description: 'Used to deliver advertisements more relevant to you through third-party platforms like Facebook and Google.',
          },
          {
            title: 'Functional Cookies:',
            description: 'Enable the website to provide enhanced functionality, such as remembering your preferences.',
          }
        ] %}

        {% for item in listData %}
          <div data-aos="flip-left" data-aos-delay="{{ 100 + (loop.index * 200) }}" class="flex flex-col gap-5 px-8 pt-7 pb-10 rounded-[20px] border border-white ">
            <span class="text-base text-white">0{{ loop.index }}/</span>
            <h3 class="text-white font-bold text-base text-balance min-h-12">{{ item.title }}</h3>
            <p class="text-small text-white text-balance">{{ item.description }}</p>
          </div>
        {% endfor %}

      </div>

    </div>
    <div class="flex flex-col gap-5">
      <h2 class="text-2xl text-white font-light capitalize">Third-Party Cookies</h2>
      <p class="text-sm text-white">We use third-party services that may place cookies on your device, including Shopify, Google Analytics, Facebook, and Klaviyo. <br/>These partners help us analyze traffic, deliver personalized ads, and optimize our marketing efforts.</p>
    </div>
    <div class="flex flex-col gap-5">
      <h2 class="text-2xl text-white font-light capitalize">Cookie Duration</h2>
      <div class="grid grid-cols-1 xs:grid-cols-2 lg:grid-cols-4 w-full gap-10 mt-10">
        {% set listData = [
          {
            title: 'Session Cookies',
            description: 'expire when you close your browser.',
          },
          {
            title: 'Marketing Cookies',
            description: 'may remain on your device for up to 12 months or longer unless you delete them manually.',
          }
        ] %}

        {% for item in listData %}
          <div data-aos="flip-left" data-aos-delay="{{ 100 + (loop.index * 200) }}" class="flex flex-col gap-5 px-8 pt-7 pb-10 rounded-[20px] border border-white min-h-69">
            <span class="text-base text-white">0{{ loop.index }}/</span>
            <h3 class="text-white font-bold text-base text-balance">{{ item.title }}</h3>
            <p class="text-small text-white text-balance">{{ item.description }}</p>
          </div>
        {% endfor %}

      </div>
    </div>
    <div class="flex flex-col gap-5">
      <h2 class="text-2xl text-white font-light capitalize">Managing Cookies</h2>
      <p class="text-sm text-white">When you visit our site, you have the option to accept or decline non-essential cookies through our cookie consent banner. <br/>Essential cookies cannot be disabled, as they are necessary for the website to function properly.</p>
    </div>

  </div>
</section>