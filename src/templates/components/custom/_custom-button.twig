{% from 'macro/icon.twig' import svg %}

<button
    type="button"
    class="{{ className | default('') }}"
    {% if data_aos %}data-aos="{{ data_aos }}"{% endif %}
>
  <p class='lg:text-xl text-sm font-bold text-left'>{{ title }}</p>
  <div class='flex items-center justify-center min-w-[66px] w-[66px] h-[66px] text-black-second rounded-full bg-[#d9d9d9]/75'>
    {{ svg('plus', 'stroke-[2px]') }}
  </div>
</button>