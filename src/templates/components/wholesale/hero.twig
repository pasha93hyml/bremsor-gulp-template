{% from 'macro/icon.twig' import svg %}

<section class="relative w-full h-[calc(var(--vh,_1vh)_*_100)] overflow-hidden">
  <div class="absolute inset-0 z-0 max-sm:w-[200dvw]">
    {{ picture('assets/images/wholesale-hero.png', 'wholesale page background', {
      width: '1920',
      height: '1080',
      class: 'absolute z-2 top-0 left-0 object-cover w-full h-[calc(var(--vh,_1vh)_*_100)] touch-none'
    }) }}
  </div>
  <div class="absolute inset-0 z-1 bg-gradient-to-b from-[rgba(10,10,10,0)] to-[#0A0A0A] opacity-75">

  </div>
  {% include 'components/homepage/hero/hero-socials.twig' %}

  <h1 data-aos="fade-in" class="absolute z-5 top-[33%] left-1/2 -translate-x-1/2 text-white text-center font-light max-xs:text-[50px] text-4xl lg:text-[80px] tracking-[5px] leading-[125%] uppercase">wholesale</h1>


  <button type="button" aria-label="scroll down one section"
          class="absolute z-5 left-1/2 -translate-x-1/2 bottom-30 mt-0 w-12 h-12 min-w-12 rounded-full border border-white flex items-center justify-center text-white cursor-pointer group js-scroll-down-btn" data-target="step_1">
    {{ svg('chevron-down', 'w-3 h-3 min-w-3 transition duration-400 ease group-hover:translate-y-1/2') }}
  </button>
</section>
