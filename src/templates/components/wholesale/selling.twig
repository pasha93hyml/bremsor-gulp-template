{% from 'macro/icon.twig' import svg %}

<section class="relative w-full">
  <div class="w-full aspect-4/3 md:aspect-16/9">
    {{ picture('assets/images/wholesale/section-bg_2.png', 'section bacground image', {class: 'w-full aspect-4/3 md:aspect-16/9 object-cover'}) }}
  </div>
  <div class="absolute z-1 inset-0 bg-gradient-to-b from-[rgba(10,10,10,0.5)] to-[rgba(10,10,10,1)]"></div>
  <div class="absolute inset-0 z-3 flex flex-col gap-10 py-15 lg:py-25">
    <div class="flex flex-col md:justify-center gap-5 lg:gap-15 flex-1 max-w-303 w-full px-5 mx-auto">
      <h2 data-aos="fade-down"
          class="text-2xl md:text-[45px] leading-[110%] font-light text-white text-center capitalize">Interested
        in Selling Bremsor <br/>Covers?</h2>

      <div class="flex flex-col gap-3 max-w-142 w-full mx-auto">
        <p data-aos="fade-up" class="text-white font-light text-small md:text-base text-center mx-auto">
          We are open to authorized resellers and private label partnership. <br/>To discuss wholesale opportunities or selling Bremsor products on your website:
        </p>
        <p data-aos="fade-up" class="text-white font-light text-small md:text-base text-center mx-auto">
          <span class="font-bold">Please fill out our Wholesale Inquiry Form or contact us directly with your company details</span> (business name, website, location, and expected order volume).
        </p>
        <p data-aos="fade-up" class="text-white font-light text-small md:text-base text-center mx-auto">
          Our team will respond within <span class="font-bold">1–2 business days</span> to discuss how we can collaborate.
        </p>
      </div>

    </div>

  </div>
</section>
