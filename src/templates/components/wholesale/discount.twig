{% from 'macro/icon.twig' import svg %}

<section class="relative w-full">
  <div class="w-full aspect-4/3 md:aspect-16/9">
    {{ picture('assets/images/wholesale/section-bg.png', 'section bacground image', {class: 'w-full aspect-4/3 md:aspect-16/9 object-cover'}) }}
  </div>
  <div class="absolute z-1 inset-0 bg-gradient-to-b from-[rgba(10,10,10,0.5)] to-[rgba(10,10,10,1)]"></div>
  <div class="absolute inset-0 z-3 flex flex-col max-md:justify-center gap-10 py-7 lg:py-25">
    <div class="flex flex-col justify-between flex-1 max-w-303 w-full px-5 mx-auto">
      <h2 data-aos="fade-down"
          class="text-2xl lg:text-[45px] max-md:leading-[110%] font-light text-white text-center capitalize">Wholesale
        Discount <br/>Structure:</h2>

      <div class="grid grid-cols-[repeat(2,_1fr)] max-md:gap-x-3 md:flex md:items-center md:justify-around gap-y-5 flex-wrap w-full">
        {% set data = [{ off: 5, sets: 10 }, { off: 10, sets: 25 }, { off: 15, sets: 50 }, { off: 20, sets: 100 }] %}
        {% for item in data %}
          <div data-aos="flip-left" data-aos-delay="{{ 100 + (loop.index * 200) }}" class="flex flex-col items-center gap-3 py-3 xs:py-10 px-3 xs:px-15 border border-white rounded-[20px]">
            <h3 class="text-small xs:text-2xl font-bold text-white leading-none uppercase">{{ item.off }}% off</h3>
            <p class="text-white text-[10px] xs:text-base leading-none">on orders of <span class="font-bold">{{ item.sets }}+ sets</span></p>
          </div>
        {% endfor %}
      </div>

      <p data-aos="fade-up" class="text-white font-light text-small lg:text-2xl text-center mx-auto">Our standard retail price starts at <br/><span class="font-bold">$285 per set of 4 covers</span></p>

    </div>

  </div>
</section>
