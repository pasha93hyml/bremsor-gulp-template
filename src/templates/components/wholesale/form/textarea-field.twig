<div class="{{ 'flex flex-col gap-2 col-span-full ' ~ form_field_classes }}" data-target="{{ name }}" data-required="{{ required is defined and required ? 'true' : 'false' }}">
  <label for="{{ name }}" class="text-xs uppercase text-black-main">{{ label }}</label>
  <textarea id="{{ name }}" name="{{ name }}" placeholder="{{ placeholder }}" class="{{ 'border border-black-main rounded-[10px] py-3 px-4 text-small placeholder:text-black-main placeholder:text-small w-full min-h-32.5 resize-none outline-none ' ~ textarea_classes }}"
            {% if required is defined and required %}required{% endif %}></textarea>
</div>