{% from 'macro/icon.twig' import svg %}

<form data-aos="flip-left" data-aos-duration="1500" class="flex flex-col gap-6 pt-10 pb-15 px-7.5 rounded-[20px] w-full bg-white" method="post" enctype="multipart/form-data">
  <p class="text-2xl text-black-main font-bold w-full text-center">Join the BREMSOR network</p>
  {% include 'components/contact/form/form-group.twig' with (
    {
      fields: [
        {type: 'text', name: 'first-name', label: 'First name*', placeholder: 'Your name here', required: 'true', input_field_classes: ''},
        {type: 'text', name: 'last-name', label: 'Last name*', placeholder: 'Your last name', required: 'true', input_field_classes: ''},
        {type: 'email', name: 'email', label: 'Email address*', placeholder: 'Your e-mail address', required: 'true', input_field_classes: ''},
        {type: 'tel', name: 'phone', label: 'Phone number*', placeholder: 'Your phone number', required: 'true', input_field_classes: ''},
        {type: 'text', name: 'company-name', label: 'Company name', placeholder: 'Company name here', required: 'false', input_field_classes: ''},
        {type: 'text', name: 'company-website', label: 'Company website', placeholder: 'Your website number', required: 'true', input_field_classes: ''},
        {type: 'textarea', name: 'message', label: 'MESSAGE', placeholder: 'Description here', required: 'true', form_field_classes: 'mt-7'},
    ],
      classes: "flex flex-col",
      fields_classes: "flex flex-col w-full lg:grid lg:grid-cols-2 grid-rows-2 gap-4",
      title_classes: "form-group-title text-xl lg:text-2xl leading-[136%] font-bold"
    }
    ) %}

  <div class="flex items-center justify-center mt-7">
    <button type="submit" aria-label="submit contact us form" class="text-black-main text-xs leading-1 max-w-35 w-full uppercase font-light flex items-center justify-between border border-black-main rounded-[57px] px-4 py-2 cursor-pointer hover:bg-black-main hover:text-white transition duration-400 ease group">
      submit
      {{ svg('chevron-left', 'w-3 h-3 rotate-180 group-hover:translate-x-1/2 transition duration-400 ease') }}
    </button>
  </div>
</form>